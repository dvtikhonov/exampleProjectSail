# Copied into container env via docker-compose (skeleton).
SERVER_PORT=8080

# Used when JPA is wired (infrastructure phase). Same MySQL as service-a/e.
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/sail_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=12345678AS

# Tests use sail_db_testing (see project TEST rule).
# SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/sail_db_testing?...

# Общий секрет с service-c для POST /internal/messenger-choice и /internal/messenger-choice/clicks.
# Заголовок: X-Messenger-Choice-Token. Значение задаётся в корневом .env.
# MESSENGER_CHOICE_LOG_URL=http://service-c:8000/internal/messenger-choice
# MESSENGER_CHOICE_CLICK_LOG_URL=http://service-c:8000/internal/messenger-choice/clicks
# MESSENGER_CHOICE_LOG_TOKEN=
