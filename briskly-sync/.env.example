# Скопируйте в .env локально (не коммитить).

# Briskly Business API (MCP briskly-target / CLI / apply)
BRISKLY_TOKEN=
# BRISKLY_BASE_URL=https://briskly.business/api/company

# Cursor SDK (live match; для fixture не нужен)
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5

# MCP food-source → service-c admin
# FOOD_SOURCE_BASE_URL=http://localhost/api/food/admin/briskly-sync
# FOOD_SOURCE_AUTH_TOKEN=

# HTTP sidecar
# BRISKLY_SYNC_PORT=8791
# Для PHP в Docker: BRISKLY_SYNC_HOST=0.0.0.0 и в service-c/.env
# BRISKLY_SYNC_ORCHESTRATOR_URL=http://host.docker.internal:8791
# BRISKLY_SYNC_HOST=0.0.0.0

# CDP capture (Chrome --remote-debugging-port; Playwright connectOverCDP)
# BRISKLY_CDP_URL=http://127.0.0.1:9222
# BRISKLY_CDP_CAPTURE_TIMEOUT_MS=20000
# Общий секрет sidecar ↔ service-c для POST /capture-token
# BRISKLY_SYNC_CAPTURE_SECRET=
