# Цель нагрузки (service-c через host-порт монорепо)
BASE_URL=http://localhost:8083

# Вывод метрик k6 в InfluxDB service-h
INFLUX_URL=http://localhost:8089/k6

# JSON с Sanctum-токенами для VU (генерируется в service-c).
# Путь относительно scripts/*.js (k6 open()), не относительно CWD:
TOKENS_FILE=../tokens.json

# Профиль нагрузки food_order_flow: deep (default) | smoke
# deep — stress 15→50→100 VU + soak ~15м + competitive/negative
# smoke — короткий 5→15 VU
PROFILE=deep
