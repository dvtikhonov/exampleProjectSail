    "test:food-order:baseline": "PROFILE=baseline k6 run --out influxdb=http://localhost:8089/k6 scripts/food_order_flow.js",
    "test:food-order:deep": "PROFILE=deep bash scripts/run_food_order.sh"
  }
}
