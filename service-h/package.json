{
  "name": "service-h-load-stand",
  "version": "1.0.0",
  "private": true,
  "description": "k6 + Grafana + InfluxDB load stand for service-c",
  "scripts": {
    "preflight:deep": "bash scripts/preflight_deep.sh",
    "test:food-order": "bash scripts/run_food_order.sh",
